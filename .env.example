# PostgreSQL connection string (Render injects this automatically from the skillos-db database).
# Local example: postgres://skillos:skillos@localhost:5432/skillos
DATABASE_URL=

# Secret used by Better Auth to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# xAI API key for the Grok-powered mentor and adaptive planning (https://console.x.ai).
# SkillOS works without it; AI features show a clear "unavailable" state.
XAI_API_KEY=

# Grok model id. Example: grok-4.7
XAI_MODEL=

# Public base URL of the app, no trailing slash. Local: http://localhost:5173
PUBLIC_APP_URL=

# Optional: Trigger.dev background jobs. Leave empty to run jobs in-process with retries.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
