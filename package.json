{
	"name": "skillos",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run db:migrate && bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"lint:fix": "biome check --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun ./scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"links:check": "bun ./scripts/check-urls.ts",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"trigger:dev": "trigger dev",
		"trigger:deploy": "trigger deploy"
	},
	"dependencies": {
		"@ai-sdk/xai": "^5.0.6",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.47.0",
		"@tanstack/svelte-query": "^6.2.4",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@trigger.dev/sdk": "^4.6.4",
		"@trpc/client": "^11.19.0",
		"@trpc/server": "^11.19.0",
		"ai": "^7.0.112",
		"better-auth": "^1.7.5",
		"drizzle-orm": "^0.45.3",
		"postgres": "^3.4.9",
		"superjson": "^2.2.6",
		"three": "^0.186.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/three": "^0.186.0",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"trigger.dev": "^4.6.4",
		"typescript": "^6",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	}
}
